# Server only. Never expose exchange or AI credentials through VITE_* variables.
QONYX_API_HOST=127.0.0.1
QONYX_API_PORT=8787

# Live orders remain disabled unless this is explicitly set to true.
QONYX_ENABLE_LIVE_TRADING=false

# Optional: require this value in the X-Qonyx-Session header outside local development.
QONYX_SESSION_TOKEN=
